# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Academia / interactive tutorials (default off). Ignored on Vercel Production.
NEXT_PUBLIC_ACADEMIA_ENABLED=false

# Local Next.js loads apps/web/.env.local automatically (NOT .env.staging.local).
# For Academia staging work, point NEXT_PUBLIC_SUPABASE_URL at SyncVete-Staging
# (owmcrqvnfubyjxrlyhlc) and keep a production backup outside git if needed.
# See docs/academia/LOCAL_STAGING_ENV.md

# IA clínica (OpenAI-compatible). Optional: OPENAI_BASE_URL, OPENAI_MODEL
OPENAI_API_KEY=
